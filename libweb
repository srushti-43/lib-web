* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --bg: #f6f7fb;
  --white: #ffffff;
  --dark: #171923;
  --muted: #8a8e9b;

  --purple: #4f46e5;
  --purple-light: #eef0ff;

  --orange: #f59e0b;
  --orange-light: #fff5df;

  --green: #10b981;
  --green-light: #e8faf3;

  --red: #ef4444;
  --red-light: #ffeded;

  --border: #e9eaf0;
}

body {
  font-family: "DM Sans", sans-serif;

  background: var(--bg);

  color: var(--dark);

  display: flex;

  min-height: 100vh;
}


/* ===================================
   SIDEBAR
=================================== */

.sidebar {
  width: 250px;

  min-height: 100vh;

  background: var(--white);

  border-right: 1px solid var(--border);

  padding: 25px 18px;

  position: fixed;

  left: 0;
  top: 0;

  display: flex;

  flex-direction: column;

  z-index: 100;
}


/* Logo */

.logo {
  display: flex;

  align-items: center;

  gap: 10px;

  padding: 5px 10px;

  margin-bottom: 40px;
}

.logo-icon {
  width: 39px;
  height: 39px;

  background: var(--purple);

  color: white;

  border-radius: 10px;

  display: flex;

  align-items: center;
  justify-content: center;

  font-family: "Playfair Display", serif;

  font-size: 21px;
}

.logo strong {
  display: block;

  font-size: 18px;

  line-height: 1;
}

.logo span {
  display: block;

  margin-top: 4px;

  font-size: 7px;

  color: var(--muted);

  font-weight: 700;

  letter-spacing: 1.8px;
}


/* Menu */

.menu-title {
  font-size: 9px;

  font-weight: 700;

  color: #b1b3bc;

  letter-spacing: 1.5px;

  padding: 0 12px;

  margin-bottom: 10px;
}

.menu-title.second {
  margin-top: 28px;
}

nav a {
  display: flex;

  align-items: center;

  gap: 13px;

  padding: 11px 12px;

  margin: 3px 0;

  color: #737681;

  text-decoration: none;

  border-radius: 8px;

  font-size: 13px;

  transition: 0.2s;
}

nav a span {
  width: 20px;

  text-align: center;

  font-size: 16px;
}

nav a:hover {
  background: #f5f5fb;

  color: var(--purple);
}

nav a.active {
  background: var(--purple-light);

  color: var(--purple);

  font-weight: 600;
}


/* Sidebar bottom */

.sidebar-bottom {
  margin-top: auto;
}


/* Help */

.help-box {
  padding: 17px;

  background: #f6f6fb;

  border-radius: 10px;

  margin-bottom: 20px;
}

.help-box strong {
  display: block;

  font-size: 12px;

  margin-bottom: 3px;
}

.help-box p {
  font-size: 10px;

  color: var(--muted);

  margin-bottom: 12px;
}

.help-box button {
  border: none;

  background: white;

  color: var(--purple);

  padding: 7px 10px;

  border-radius: 5px;

  font-size: 10px;

  font-weight: 600;

  cursor: pointer;
}


/* Profile */

.profile {
  display: flex;

  align-items: center;

  gap: 10px;

  padding: 12px 5px 0;

  border-top: 1px solid var(--border);
}

.avatar {
  width: 34px;
  height: 34px;

  background: #dedcff;

  color: var(--purple);

  border-radius: 50%;

  display: flex;

  align-items: center;
  justify-content: center;

  font-size: 10px;

  font-weight: 700;
}

.profile strong,
.profile span {
  display: block;
}

.profile strong {
  font-size: 11px;
}

.profile span {
  color: var(--muted);

  font-size: 9px;
}

.profile .dots {
  margin-left: auto;

  font-size: 12px;
}


/* ===================================
   MAIN
=================================== */

.main {
  margin-left: 250px;

  width: calc(100% - 250px);

  min-height: 100vh;
}


/* ===================================
   TOP BAR
=================================== */

.topbar {
  min-height: 90px;

  padding: 25px 40px;

  background: var(--white);

  border-bottom: 1px solid var(--border);

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 30px;
}

.topbar h1 {
  font-family: "Playfair Display", serif;

  font-size: 25px;

  margin-bottom: 3px;
}

.topbar p {
  color: var(--muted);

  font-size: 11px;
}

.top-actions {
  display: flex;

  align-items: center;

  gap: 15px;
}

.search {
  width: 250px;

  height: 38px;

  border: 1px solid var(--border);

  border-radius: 7px;

  display: flex;

  align-items: center;

  gap: 8px;

  padding: 0 12px;

  color: #a5a7b0;
}

.search input {
  border: none;

  outline: none;

  width: 100%;

  font-family: inherit;

  font-size: 11px;
}

.notification {
  width: 38px;
  height: 38px;

  border: 1px solid var(--border);

  background: white;

  border-radius: 7px;

  cursor: pointer;

  position: relative;

  color: #666;
}

.notification span {
  width: 6px;
  height: 6px;

  background: var(--red);

  border: 2px solid white;

  border-radius: 50%;

  position: absolute;

  top: 8px;
  right: 8px;
}

.mobile-menu {
  display: none;
}


/* ===================================
   DASHBOARD
=================================== */

.dashboard {
  padding: 30px 40px;

  max-width: 1600px;

  margin: auto;
}


/* ===================================
   STAT CARDS
=================================== */

.stats {
  display: grid;

  grid-template-columns: repeat(4, 1fr);

  gap: 15px;

  margin-bottom: 20px;
}

.stat-card {
  background: white;

  border: 1px solid var(--border);

  border-radius: 10px;

  padding: 20px;

  display: flex;

  align-items: center;

  gap: 15px;
}

.stat-icon {
  width: 45px;
  height: 45px;

  border-radius: 10px;

  display: flex;

  align-items: center;
  justify-content: center;

  font-size: 18px;

  flex-shrink: 0;
}

.stat-icon.blue {
  color: #4f46e5;

  background: #eef0ff;
}

.stat-icon.purple {
  color: #9333ea;

  background: #f5eaff;
}

.stat-icon.orange {
  color: #d97706;

  background: #fff4dd;
}

.stat-icon.red {
  color: #dc2626;

  background: #ffeded;
}

.stat-card span {
  display: block;

  color: var(--muted);

  font-size: 10px;

  margin-bottom: 2px;
}

.stat-card strong {
  display: block;

  font-family: "Playfair Display", serif;

  font-size: 27px;

  line-height: 1.2;
}

.stat-card small {
  font-size: 9px;

  color: var(--muted);
}

.stat-card small.positive {
  color: var(--green);
}

.stat-card small.negative {
  color: var(--red);
}


/* ===================================
   PANELS
=================================== */

.panel {
  background: white;

  border: 1px solid var(--border);

  border-radius: 10px;

  overflow: hidden;
}

.panel-header {
  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 20px 22px;

  border-bottom: 1px solid var(--border);
}

.panel-header h2 {
  font-size: 14px;

  margin-bottom: 2px;
}

.panel-header p {
  color: var(--muted);

  font-size: 9px;
}

.panel-header select {
  border: 1px solid var(--border);

  padding: 7px 10px;

  border-radius: 5px;

  color: #666;

  background: white;

  font-family: inherit;

  font-size: 9px;
}


/* ===================================
   MIDDLE GRID
=================================== */

.middle-grid {
  display: grid;

  grid-template-columns: 1.6fr 1fr;

  gap: 20px;

  margin-bottom: 20px;
}


/* ===================================
   CHART
=================================== */

.chart-panel {
  min-height: 340px;
}

.chart {
  display: flex;

  height: 245px;

  padding: 20px 25px 15px;
}

.y-axis {
  width: 35px;

  display: flex;

  flex-direction: column;

  justify-content: space-between;

  color: #aaa;

  font-size: 8px;

  padding-bottom: 20px;
}

.chart-area {
  flex: 1;

  position: relative;

  margin-left: 10px;
}

.grid-line {
  position: absolute;

  width: 100%;

  border-top: 1px dashed #e9eaf0;
}

.line1 {
  top: 0;
}

.line2 {
  top: 25%;
}

.line3 {
  top: 50%;
}

.line4 {
  top: 75%;
}

.line5 {
  bottom: 20px;
}

.chart-svg {
  position: absolute;

  width: 100%;

  height: calc(100% - 20px);

  left: 0;
  top: 0;
}

.x-axis {
  position: absolute;

  bottom: 0;

  width: 100%;

  display: flex;

  justify-content: space-between;

  color: #aaa;

  font-size: 8px;
}


/* ===================================
   QUICK ACTIONS
=================================== */

.quick-actions {
  padding: 8px 15px 15px;
}

.quick-actions button {
  width: 100%;

  border: none;

  background: white;

  padding: 12px 7px;

  display: flex;

  align-items: center;

  gap: 12px;

  text-align: left;

  cursor: pointer;

  border-bottom: 1px solid #f0f0f3;
}

.quick-actions button:last-child {
  border: none;
}

.action-icon {
  width: 35px;
  height: 35px;

  border-radius: 8px;

  display: flex;

  align-items: center;
  justify-content: center;

  font-weight: 600;
}

.action-icon.blue {
  background: #eef0ff;
  color: var(--purple);
}

.action-icon.purple {
  background: #f5eaff;
  color: #9333ea;
}

.action-icon.orange {
  background: #fff4dd;
  color: #d97706;
}

.action-icon.green {
  background: var(--green-light);
  color: var(--green);
}

.quick-actions strong,
.quick-actions span {
  display: block;
}

.quick-actions strong {
  font-size: 10px;
}

.quick-actions span {
  color: var(--muted);

  font-size: 8px;
}

.quick-actions b {
  margin-left: auto;

  color: #aaa;

  font-size: 12px;
}


/* ===================================
   BOTTOM GRID
=================================== */

.bottom-grid {
  display: grid;

  grid-template-columns: 1.6fr 1fr;

  gap: 20px;
}

.table-panel {
  min-width: 0;
}

.panel-header a {
  color: var(--purple);

  font-size: 9px;

  font-weight: 600;
}


/* ===================================
   TABLE
=================================== */

.table-wrapper {
  overflow-x: auto;
}

table {
  width: 100%;

  border-collapse: collapse;

  min-width: 650px;
}

th {
  padding: 12px 20px;

  text-align: left;

  color: #aaa;

  font-size: 8px;

  font-weight: 700;

  letter-spacing: .5px;

  border-bottom: 1px solid var(--border);
}

td {
  padding: 14px 20px;

  border-bottom: 1px solid #f0f0f3;

  font-size: 9px;

  color: #666;
}

.book {
  display: flex;

  align-items: center;

  gap: 10px;
}

.book-cover {
  width: 29px;
  height: 38px;

  border-radius: 3px;

  display: flex;

  align-items: center;
  justify-content: center;

  color: white;

  font-family: "Playfair Display", serif;

  font-size: 13px;
}

.blue-cover {
  background: linear-gradient(135deg, #4f46e5, #818cf8);
}

.orange-cover {
  background: linear-gradient(135deg, #ea580c, #fb923c);
}

.green-cover {
  background: linear-gradient(135deg, #047857, #34d399);
}

.purple-cover {
  background: linear-gradient(135deg, #7e22ce, #c084fc);
}

.book strong,
.book span {
  display: block;
}

.book strong {
  color: #333;

  font-size: 9px;
}

.book span {
  color: #aaa;

  font-size: 8px;
}

.member {
  display: flex;

  align-items: center;

  gap: 7px;
}

.small-avatar {
  width: 23px;
  height: 23px;

  background: #dedcff;

  color: var(--purple);

  border-radius: 50%;

  display: flex;

  align-items: center;
  justify-content: center;

  font-size: 7px;

  font-weight: 700;
}

.purple-avatar {
  background: #f0ddff;

  color: #9333ea;
}

.status {
  padding: 4px 7px;

  border-radius: 20px;

  font-size: 7px;

  font-weight: 600;
}

.active-status {
  background: var(--green-light);

  color: var(--green);
}

.overdue-status {
  background: var(--red-light);

  color: var(--red);
}


/* ===================================
   POPULAR BOOKS
=================================== */

.popular-list {
  padding: 7px 20px 15px;
}

.popular-book {
  display: flex;

  align-items: center;

  gap: 10px;

  padding: 12px 0;

  border-bottom: 1px solid #f0f0f3;
}

.popular-book:last-child {
  border: none;
}

.rank {
  width: 18px;

  color: #bbb;

  font-size: 9px;
}

.mini-cover {
  width: 28px;
  height: 36px;

  border-radius: 3px;

  display: flex;

  align-items: center;
  justify-content: center;

  color: white;

  font-family: "Playfair Display", serif;
}

.popular-info {
  flex: 1;
}

.popular-info strong,
.popular-info span {
  display: block;
}

.popular-info strong {
  font-size: 9px;
}

.popular-info span {
  color: #aaa;

  font-size: 8px;
}

.popular-book > b {
  font-size: 10px;

  color: #555;
}


/* ===================================
   FOOTER
=================================== */

footer {
  border-top: 1px solid var(--border);

  background: white;

  padding: 20px 40px;

  display: flex;

  justify-content: space-between;

  color: #aaa;

  font-size: 8px;
}


/* ===================================
   RESPONSIVE
=================================== */

@media (max-width: 1100px) {

  .stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .middle-grid,
  .bottom-grid {
    grid-template-columns: 1fr;
  }

}


@media (max-width: 800px) {

  .sidebar {
    transform: translateX(-100%);

    transition: .25s;
  }

  .sidebar.open {
    transform: translateX(0);
  }

  .main {
    margin-left: 0;

    width: 100%;
  }

  .mobile-menu {
    display: inline-block;

    border: none;

    background: none;

    font-size: 20px;

    cursor: pointer;

    margin-right: 8px;
  }

  .topbar {
    padding: 20px;
  }

  .top-actions {
    display: none;
  }

  .dashboard {
    padding: 20px;
  }

}


@media (max-width: 500px) {

  .stats {
    grid-template-columns: 1fr;
  }

  .topbar h1 {
    font-size: 21px;
  }

  footer {
    padding: 20px;

    flex-direction: column;

    gap: 6px;
  }

}




